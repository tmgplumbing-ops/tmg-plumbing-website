---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CATEGORIES, categoryOf, coverOf, readingMinutes, formatDate } from '../../data/blog';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
const [featured, ...rest] = posts;
const used = new Set(posts.map((p) => categoryOf(p.slug).name));
const cats = CATEGORIES.filter((c) => used.has(c.name));
const slugify = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-');
---
<BaseLayout
  title="Blog | TMG Plumbing & Heating"
  description="Guidance on heating maintenance, power flushing, underfloor heating and more from TMG Plumbing & Heating Services."
>
  <!-- Header -->
  <section class="bg-navy">
    <div class="mx-auto max-w-6xl px-4 pt-14 pb-10">
      <p class="text-orange text-sm">The TMG blog</p>
      <h1 class="mt-2 text-3xl md:text-5xl font-medium text-white max-w-3xl leading-tight">Heating advice from the people who fix it</h1>
      <p class="mt-4 text-white/70 max-w-2xl">Practical guides on power flushing, underfloor heating, water treatment and keeping your system running, from 20 years of jobs across the South East.</p>
      <div class="mt-8 flex flex-wrap gap-2" id="blog-filters">
        <button type="button" data-cat="all" class="blog-chip is-active">All articles</button>
        {cats.map((c) => <button type="button" data-cat={slugify(c.name)} class="blog-chip">{c.name}</button>)}
      </div>
    </div>
  </section>

  <!-- Featured -->
  <section class="bg-navy pb-14">
    <div class="mx-auto max-w-6xl px-4">
      <a href={`/blog/${featured.slug}`} class="group grid md:grid-cols-2 rounded-card overflow-hidden bg-white" data-post-cat={slugify(categoryOf(featured.slug).name)}>
        <div class="aspect-[16/10] md:aspect-auto md:h-[380px] overflow-hidden">
          <Image src={coverOf(featured).src} alt="" widths={[640, 1000]} sizes="(min-width: 768px) 560px, 100vw" loading="eager" class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105" />
        </div>
        <div class="p-7 md:p-10 flex flex-col justify-center">
          <p class="text-xs text-orange uppercase tracking-wider">Latest · {categoryOf(featured.slug).name}</p>
          <p class="mt-3 text-2xl md:text-3xl font-medium text-navy leading-snug group-hover:text-orange transition-colors">{featured.data.title}</p>
          <p class="mt-3 text-navy/60">{featured.data.excerpt}</p>
          <p class="mt-5 text-sm text-navy/50">{formatDate(featured.data.publishDate)} · {readingMinutes(featured)} min read</p>
        </div>
      </a>
    </div>
  </section>

  <!-- Grid -->
  <section class="mx-auto max-w-6xl px-4 py-14">
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6" id="blog-grid">
      {rest.map((post) => {
        const cat = categoryOf(post.slug);
        return (
          <a href={`/blog/${post.slug}`} class="group flex flex-col rounded-card bg-white border border-navy/10 overflow-hidden hover:border-orange hover:shadow-lg transition" data-post-cat={slugify(cat.name)}>
            <div class="aspect-[16/10] overflow-hidden bg-mist">
              <Image src={coverOf(post).src} alt="" widths={[400, 700]} sizes="(min-width: 1024px) 360px, (min-width: 640px) 50vw, 100vw" class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105" />
            </div>
            <div class="p-5 flex flex-col flex-1">
              <p class="text-xs text-orange">{cat.name}</p>
              <p class="mt-1.5 text-navy font-medium text-lg leading-snug group-hover:text-orange transition-colors">{post.data.title}</p>
              <p class="mt-2 text-sm text-navy/60 line-clamp-2">{post.data.excerpt}</p>
              <p class="mt-auto pt-4 text-xs text-navy/45">{formatDate(post.data.publishDate)} · {readingMinutes(post)} min read</p>
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <!-- CTA -->
  <section class="border-t border-navy/10 bg-mist">
    <div class="mx-auto max-w-6xl px-4 py-12 flex flex-col md:flex-row md:items-center md:justify-between gap-6">
      <div>
        <p class="text-xl font-medium text-navy">Got a heating problem we haven't covered?</p>
        <p class="mt-1 text-navy/60">Ask us. We're happy to give advice, or come out and take a look.</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href="/contact" class="rounded bg-orange text-white font-medium px-5 py-3 hover:bg-orange-dark">Get in touch</a>
        <a href="tel:051577089" class="rounded border border-navy/20 text-navy px-5 py-3 hover:border-orange hover:text-orange">Call 051 577 089</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .blog-chip { border: 1px solid rgba(255, 255, 255, 0.25); color: rgba(255, 255, 255, 0.85); border-radius: 9999px; padding: 0.4rem 0.9rem; font-size: 0.875rem; }
  .blog-chip:hover { border-color: #CE5600; color: #fff; }
  .blog-chip.is-active { background: #CE5600; border-color: #CE5600; color: #fff; }
</style>

<script>
  // Category filter. Without JS every post simply shows.
  const chips = document.querySelectorAll<HTMLButtonElement>('#blog-filters .blog-chip');
  const cards = document.querySelectorAll<HTMLElement>('[data-post-cat]');
  chips.forEach((chip) => chip.addEventListener('click', () => {
    const cat = chip.dataset.cat;
    chips.forEach((c) => c.classList.toggle('is-active', c === chip));
    cards.forEach((card) => { card.style.display = cat === 'all' || card.dataset.postCat === cat ? '' : 'none'; });
  }));
</script>
