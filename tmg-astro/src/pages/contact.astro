---
import BaseLayout from '../layouts/BaseLayout.astro';
import QuoteForm from '../components/QuoteForm.astro';
---
<BaseLayout
  title="Contact TMG | Get a Quote from Plumbers in Waterford"
  description="Request a quote from TMG Plumbing & Heating, plumbers and heating contractors in Waterford. Fixed price before we start. Call 051 577089."
>
  <section class="mx-auto max-w-6xl px-4 py-16 grid md:grid-cols-[1fr_360px] gap-12">
    <!-- Left: enquiry form -->
    <div>
      <h1 class="text-3xl font-medium text-navy mb-2">Get a quote</h1>
      <p class="text-navy/70 mb-4">Tell us about the work you need and we'll get back to you as soon as we can with a fixed price.</p>
      <div class="mb-8 rounded-card bg-mist border border-navy/10 p-5 text-sm text-navy/75">
        <p class="text-navy font-medium mb-2">To help us quote accurately, please include:</p>
        <ul class="space-y-1">
          <li class="flex gap-2"><span class="text-orange">•</span>The number of radiators or underfloor heating manifolds</li>
          <li class="flex gap-2"><span class="text-orange">•</span>Your boiler or heat pump type, and when it was last serviced</li>
          <li class="flex gap-2"><span class="text-orange">•</span>Photos of the radiators, manifolds and boiler or heat pump, if you can</li>
        </ul>
      </div>

      <!--
        Submits directly into Zoho CRM as a Lead — the same pipeline the
        current tmgplumbing.ie site uses. See src/components/QuoteForm.astro.
      -->
      <QuoteForm />
    </div>

    <!-- Right: contact cards -->
    <aside class="space-y-4">
      <div class="rounded-card bg-mist border border-navy/10 p-6">
        <p class="text-navy font-medium mb-2">Call now</p>
        <a href="tel:051577089" class="block text-orange">051 577 089</a>
        <a href="https://wa.me/353877175624" class="block text-navy/60 text-sm mt-1">WhatsApp: 087 717 5624</a>
      </div>
      <div class="rounded-card bg-mist border border-navy/10 p-6">
        <p class="text-navy font-medium mb-2">Office hours</p>
        <p class="text-navy/60 text-sm">Mon–Fri, 8am–6pm</p>
      </div>
      <div class="rounded-card bg-mist border border-navy/10 p-6">
        <p class="text-navy font-medium mb-2">Address</p>
        <p class="text-navy/60 text-sm">Unit 17F, Six Cross Roads Business Park,<br />Waterford, X91KV09</p>
      </div>
      <div class="rounded-card bg-mist border border-navy/10 p-6">
        <p class="text-navy font-medium mb-2">Email</p>
        <a href="mailto:info@tmgplumbing.ie" class="text-orange text-sm">info@tmgplumbing.ie</a>
      </div>
    </aside>
  </section>
</BaseLayout>
