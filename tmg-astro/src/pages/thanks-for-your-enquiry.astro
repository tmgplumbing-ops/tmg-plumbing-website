---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Thanks for your enquiry | TMG Plumbing & Heating"
  description="Thanks for getting in touch with TMG Plumbing & Heating Services. We'll respond the same day."
>
  <section class="mx-auto max-w-2xl px-4 py-24 text-center">
    <h1 class="text-3xl md:text-4xl font-medium text-navy mb-4">Thanks — that's with us.</h1>
    <p class="text-navy/70 max-w-md mx-auto">
      We've received your enquiry and will respond the same day, Monday to
      Friday. If it's urgent, call us directly on 051 577 089.
    </p>
    <div class="pt-8 flex justify-center gap-3">
      <a href="/" class="rounded bg-orange text-white font-medium px-6 py-3 hover:bg-orange-dark">Back to homepage</a>
      <a href="tel:051577089" class="rounded border border-navy/20 text-navy px-6 py-3 hover:border-orange hover:text-orange">Call 051 577 089</a>
    </div>
  </section>
</BaseLayout>
