---
import BaseLayout from '../layouts/BaseLayout.astro';
import Schema from '../components/Schema.astro';
import { Image } from 'astro:assets';
import { heroes, sectorPhotos } from '../data/photos';
import ServiceIcon from '../components/ServiceIcon.astro';
import { getCollection } from 'astro:content';
import { coverOf, categoryOf, readingMinutes } from '../data/blog';

const services = [
  { slug: 'power-flushing', name: 'Power flushing', href: '/services/power-flushing', desc: 'Clear sludge, restore even heat.' },
  { name: 'Underfloor heating', href: '/services/underfloor-heating', slug: 'underfloor-heating', desc: 'Installation and servicing.' },
  { name: 'Leak detection', href: '/services/leak-detection', slug: 'leak-detection', desc: 'Find leaks without tearing up floors.' },
  { name: 'Demineralisation', href: '/services/demineralisation', slug: 'demineralisation', desc: 'Cleaner water, longer system life.' },
  { name: 'Chemical-free pipe cleaning', href: '/water-treatment#chemical-free-pipe-cleaning', slug: 'chemical-free-cleaning', desc: 'Air-pulse and ultrasonic cleaning, no chemicals.' },
  { name: 'Heating water treatment', href: '/water-treatment', slug: 'heating-water-treatment', desc: 'Protect boilers and pipework from scale and corrosion.' },
  { name: 'Water testing', href: '/water-treatment#water-testing', slug: 'water-testing', desc: "Know exactly what's in your system water." },
  { name: 'Oil boiler installs', href: '/services/oil-boiler-installs', slug: 'oil-boiler-installs', desc: 'New installs and replacements.' },
  { name: 'Plumbing & heating', href: '/services/plumbing-heating', slug: 'plumbing-heating', desc: 'General plumbing and heating work.' },
];
const areas = [
  { name: 'Waterford', text: 'Our home base. Power flushing, leak detection, underfloor heating and full plumbing and heating services across the city and county.',
    links: [{ name: 'Power flushing Waterford', href: '/power-flushing-waterford' }, { name: 'Leak detection Waterford', href: '/leak-detection-waterford' }, { name: 'Underfloor heating Waterford', href: '/underfloor-heating-waterford' }] },
  { name: 'Kilkenny', text: 'Power flushing, heating repairs and water treatment for homes across Kilkenny.', links: [{ name: 'Power flushing Kilkenny', href: '/power-flushing-kilkenny' }] },
  { name: 'Wexford', text: 'Regular work across Wexford, from sludged radiators to new boiler installs.', links: [{ name: 'Power flushing Wexford', href: '/power-flushing-wexford' }] },
  { name: 'Tipperary', text: 'Heating system cleaning, servicing and upgrades throughout Tipperary.', links: [{ name: 'Power flushing Tipperary', href: '/power-flushing-tipperary' }] },
  { name: 'Kildare', text: 'Domestic plumbing and heating work in Kildare, plus commercial sites.', links: [] },
  { name: 'Nationwide', text: 'Commercial power flushing, demineralisation and water treatment anywhere in Ireland.', links: [{ name: 'Commercial services', href: '/commercial' }] },
];

const sectors = [
  { slug: 'hospitals', name: 'Hospitals', href: '/commercial/hospitals' },
  { slug: 'hotels', name: 'Hotels', href: '/commercial/hotels' },
  { slug: 'schools-colleges', name: 'Schools & colleges', href: '/commercial/schools-colleges' },
  { slug: 'office-buildings', name: 'Offices', href: '/commercial/office-buildings' },
  { slug: 'industrial', name: 'Industrial sites', href: '/commercial/industrial' },
  { slug: 'facility-maintenance', name: 'Facility maintenance', href: '/commercial/facility-maintenance' },
];
const commercialServices = [
  'Commercial power flushing',
  'Demineralisation and heating water treatment',
  'Water testing to VDI 2035',
  'Chemical-free pipe cleaning (air-pulse and ultrasonic)',
  'Planned maintenance and response contracts',
];

const usps = [
  'Since 2006',
  'Fixed price before we start',
  'No-mess cleaning methods',
  'Commercial work nationwide',
];

const faqs = [
  { q: 'What areas do you cover?', a: 'We carry out domestic work across Waterford, Wexford, Kilkenny, Tipperary and Kildare. Commercial work, including power flushing, demineralisation and water treatment, is carried out nationwide.' },
  { q: 'How much does a power flush cost?', a: 'It depends on how many radiators you have and the condition of the system. Tell us your radiator count and we will give you a fixed price before any work begins.' },
  { q: 'How long does a power flush take?', a: 'Most homes take between four and eight hours, completed in a single visit.' },
  { q: 'Do you work on commercial buildings?', a: 'Yes. We work in hospitals, hotels, schools and colleges, offices and industrial sites, with planned maintenance and response contracts for facilities teams anywhere in Ireland.' },
  { q: 'What is demineralisation, and does my heating system need it?', a: 'Demineralisation removes the calcium, magnesium and other minerals from the water in your heating system, so it cannot form scale or speed up corrosion. Most boiler and heat pump manufacturers now set water quality limits based on VDI 2035, and treated water keeps your system within them.' },
  { q: 'Can you find a leak without digging up my floor?', a: 'Usually, yes. We use thermal imaging and acoustic listening equipment to pinpoint the leak before any excavation is considered, and we can provide a written report for your insurer.' },
  { q: 'Do you offer emergency call-outs?', a: 'Yes. Our office is open Monday to Friday, 8am to 6pm, on 051 577 089. For emergencies, call 087 717 5624.' },
];

const latest = (await getCollection('blog'))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);
---
<BaseLayout
  title="TMG Plumbing & Heating Services | Plumbers & Heating Contractors Waterford"
  description="Specialist plumbing and heating across Waterford, Wexford, Kilkenny, Tipperary & Kildare. Domestic, and commercial nationwide. Call 051 577089."
>
  <Schema faqs={faqs} />

  <!-- Hero -->
  <section class="border-b border-navy/10 bg-mist">
    <div class="mx-auto max-w-6xl px-4 py-16 md:py-24 grid md:grid-cols-[1fr_400px] gap-12 items-center">
      <div>
      <h1 class="text-4xl md:text-6xl font-medium text-navy max-w-3xl leading-tight">
        Specialist heating services <span class="text-orange">across Ireland.</span>
      </h1>
      <p class="mt-6 text-navy/70 max-w-xl text-lg">
        Commercial heating system cleaning and water treatment nationwide, and domestic plumbing and
        heating across the South East, since 2006.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/contact" class="rounded bg-orange text-white font-medium px-6 py-3 hover:bg-orange-dark">Get a quote</a>
        <a href="/commercial" class="rounded border border-navy/20 text-navy px-6 py-3 hover:border-orange hover:text-orange">Commercial services</a>
      </div>
      <div class="mt-12 grid grid-cols-3 max-w-md gap-6 text-center">
        <div><p class="text-2xl font-medium text-orange">20+</p><p class="text-xs text-navy/50">years experience</p></div>
        <div><p class="text-2xl font-medium text-orange">Nationwide</p><p class="text-xs text-navy/50">commercial work</p></div>
        <div><p class="text-2xl font-medium text-orange">1,000s</p><p class="text-xs text-navy/50">jobs completed</p></div>
      </div>
      </div>
      <div class="relative">
        <div class="rounded-card overflow-hidden aspect-[4/5] shadow-xl">
          <Image src={heroes.home.src} alt={heroes.home.alt} widths={[400, 800]} sizes="(min-width: 768px) 400px, 100vw" loading="eager" class="w-full h-full object-cover" />
        </div>
        <div class="absolute -bottom-4 -left-4 rounded-card bg-white shadow-lg px-4 py-3 text-sm text-navy">
          <span class="text-orange font-medium">Since 2006</span> · Waterford
        </div>
      </div>
    </div>
  </section>

  <!-- USP band -->
  <section class="border-b border-navy/10 bg-white">
    <ul class="mx-auto max-w-6xl px-4 py-5 flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-sm text-navy/80">
      {usps.map((u) => (
        <li class="flex items-center gap-2">
          <svg viewBox="0 0 20 20" class="w-5 h-5 flex-none" aria-hidden="true"><circle cx="10" cy="10" r="9" fill="#CE5600" fill-opacity="0.12" /><path d="M6 10.5l2.5 2.5L14 7.5" fill="none" stroke="#CE5600" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
          {u}
        </li>
      ))}
    </ul>
  </section>

  <!-- Services grid -->
  <section class="mx-auto max-w-6xl px-4 py-16">
    <h2 class="text-2xl font-medium text-navy mb-8">Services</h2>
    <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-4">
      {services.map((s) => (
        <a href={s.href} class="group rounded-card bg-mist border border-navy/10 overflow-hidden hover:border-orange transition-colors">
          <div class="relative aspect-[16/9] bg-navy flex items-center justify-center overflow-hidden">
            <div class="absolute -right-10 -bottom-10 w-40 h-40 rounded-full border-[18px] border-orange/15"></div>
            <div class="absolute -left-6 -top-8 w-24 h-24 rounded-full border-[10px] border-white/5"></div>
            <ServiceIcon name={s.slug} class="relative w-20 h-20 transition-transform duration-300 group-hover:scale-110" />
          </div>
          <div class="p-5">
            <p class="text-navy font-medium">{s.name}</p>
            <p class="text-navy/50 text-sm mt-1">{s.desc}</p>
            <p class="text-orange text-sm mt-3">Learn more →</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Commercial -->
  <section class="bg-navy">
    <div class="mx-auto max-w-6xl px-4 py-16 grid lg:grid-cols-[1fr_1.3fr] gap-10 items-start">
      <div>
        <p class="text-orange text-sm font-medium">Commercial · nationwide</p>
        <h2 class="mt-2 text-2xl md:text-3xl font-medium text-white leading-snug">Commercial heating services across Ireland</h2>
        <p class="mt-4 text-white/70 leading-relaxed">
          We clean, treat and maintain the heating systems in hospitals, hotels, schools, offices and industrial
          sites anywhere in Ireland. Work is planned around your building to keep disruption to a minimum.
        </p>
        <ul class="mt-6 space-y-2 text-sm text-white/85">
          {commercialServices.map((c) => (
            <li class="flex gap-2">
              <svg viewBox="0 0 20 20" class="w-4 h-4 mt-0.5 flex-none" aria-hidden="true"><path d="M4 10.5l4 4 8-9" fill="none" stroke="#CE5600" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
              {c}
            </li>
          ))}
        </ul>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/commercial" class="rounded bg-orange text-white font-medium px-5 py-3 hover:bg-orange-dark">Commercial services</a>
          <a href="/contact" class="rounded border border-white/20 text-white px-5 py-3 hover:border-orange hover:text-orange">Request a site survey</a>
        </div>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
        {sectors.map((c) => (
          <a href={c.href} class="group relative rounded-card overflow-hidden aspect-[4/3] bg-white/5">
            {sectorPhotos[c.slug] && (
              <Image src={sectorPhotos[c.slug].src} alt="" widths={[300, 600]} sizes="(min-width: 1024px) 200px, 50vw" class="absolute inset-0 w-full h-full object-cover opacity-70 transition duration-300 group-hover:opacity-90 group-hover:scale-105" />
            )}
            <div class="absolute inset-0 bg-gradient-to-t from-navy/90 via-navy/30 to-transparent"></div>
            <p class="absolute left-3 bottom-3 right-3 text-white text-sm font-medium">{c.name} →</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Intro -->
  <section class="mx-auto max-w-6xl px-4 py-16">
    <div class="rounded-card bg-mist border border-navy/10 p-8 md:p-10 grid md:grid-cols-[1fr_1.4fr] gap-8">
      <h2 class="text-2xl md:text-3xl font-medium text-navy leading-snug">Heating specialists for Irish businesses and South East homes</h2>
      <div>
        <p class="text-navy/70 leading-relaxed">
          TMG Plumbing &amp; Heating Services are plumbers and heating contractors based in Waterford, looking after
          homes and businesses across Waterford, Wexford, Kilkenny, Tipperary and Kildare since 2006. We specialise in keeping heating systems clean and efficient:
          power flushing, demineralisation and water treatment, alongside underfloor heating, leak detection,
          oil boiler installs and everyday plumbing and heating work.
        </p>
        <p class="mt-3 text-navy/70 leading-relaxed">
          Commercial work is a core part of what we do. Facilities teams across Ireland use us to power flush,
          demineralise and maintain large heating systems, with planned maintenance and response contracts that
          keep plant rooms running and within manufacturer water quality limits.
        </p>
      </div>
    </div>
  </section>

  <!-- Coverage -->
  <section class="bg-mist border-y border-navy/10">
    <div class="mx-auto max-w-6xl px-4 py-16">
      <h2 class="text-2xl font-medium text-navy">Where we work</h2>
      <p class="mt-2 text-navy/60 max-w-2xl">Commercial contracts anywhere in Ireland, and domestic plumbing and heating across five counties in the South East.</p>
      <div class="mt-8 grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {areas.map((a) => (
          <div class="rounded-card bg-white border border-navy/10 p-5">
            <p class="text-navy font-medium">{a.name}</p>
            <p class="text-navy/60 text-sm mt-1">{a.text}</p>
            {a.links.length > 0 && (
              <ul class="mt-3 space-y-1">
                {a.links.map((l) => <li><a href={l.href} class="text-sm text-orange hover:underline">{l.name} →</a></li>)}
              </ul>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Latest advice -->
  <section class="mx-auto max-w-6xl px-4 py-16">
    <div class="flex items-end justify-between gap-4 mb-6">
      <h2 class="text-2xl font-medium text-navy">Latest heating advice</h2>
      <a href="/blog" class="text-sm text-orange hover:underline">All articles →</a>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {latest.map((p) => (
        <a href={`/blog/${p.slug}`} class="group rounded-card bg-white border border-navy/10 overflow-hidden hover:border-orange">
          <div class="aspect-[16/10] overflow-hidden">
            <Image src={coverOf(p).src} alt="" widths={[400, 700]} sizes="(min-width: 1024px) 360px, 100vw" class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105" />
          </div>
          <div class="p-5">
            <p class="text-xs text-orange">{categoryOf(p.slug).name}</p>
            <p class="mt-1 text-navy font-medium leading-snug">{p.data.title}</p>
            <p class="mt-2 text-sm text-navy/60 line-clamp-2">{p.data.excerpt}</p>
            <p class="mt-3 text-xs text-navy/45">{readingMinutes(p)} min read</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- FAQs -->
  <section class="border-t border-navy/10">
    <div class="mx-auto max-w-4xl px-4 py-16">
      <h2 class="text-2xl font-medium text-navy mb-6">Frequently asked questions</h2>
      <div class="space-y-3">
        {faqs.map((f) => (
          <details class="group rounded-card bg-mist border border-navy/10 p-4">
            <summary class="cursor-pointer list-none flex justify-between gap-4 text-navy font-medium">
              {f.q}<span class="text-orange transition-transform group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <p class="mt-2 text-navy/60 text-sm leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- About teaser -->
  <section class="mx-auto max-w-6xl px-4 py-16 border-t border-navy/10 grid md:grid-cols-2 gap-8 items-center">
    <div>
      <h2 class="text-2xl font-medium text-navy mb-4">About TMG</h2>
      <p class="text-navy/60">
        Founded by Tony McGuinness in 2006, TMG has grown into the South East's
        leading plumbing and heating specialist, trusted by homeowners and
        commercial clients across Ireland.
      </p>
      <a href="/about" class="inline-block mt-4 text-orange">Read our story →</a>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="bg-navy border-t border-navy/10">
    <div class="mx-auto max-w-6xl px-4 py-16 text-center">
      <h2 class="text-2xl md:text-3xl font-medium text-white mb-6">Need a heating specialist?</h2>
      <div class="flex flex-wrap justify-center gap-3">
        <a href="/contact" class="rounded bg-orange text-white font-medium px-6 py-3 hover:bg-orange-dark">Get a quote</a>
        <a href="tel:051577089" class="rounded border border-white/20 text-white px-6 py-3 hover:border-orange hover:text-orange">Call 051 577 089</a>
      </div>
    </div>
  </section>
</BaseLayout>
