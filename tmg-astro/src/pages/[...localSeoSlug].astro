---
// Flat local SEO URLs (e.g. /power-flushing-waterford). Same template as the
// core service pages. Each local page now has its own content and its own
// (self) canonical, so it can rank in its own right (Oct 2026); before that
// they pointed their canonical at the parent service page.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ServicePageBody from '../components/ServicePageBody.astro';

export async function getStaticPaths() {
  const pages = await getCollection('local-seo');
  return pages.map((entry) => ({
    params: { localSeoSlug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { title, metaDescription, canonicalService, seoTitle } = entry.data;
---
<BaseLayout title={seoTitle ?? `${title} | TMG Plumbing & Heating`} description={metaDescription}>
  <ServicePageBody data={entry.data} noticeSlug={canonicalService} />
</BaseLayout>
