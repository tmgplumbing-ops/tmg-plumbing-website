---
// Commercial overview (replaces the old /power-flushing-commercial page).
// Uses the shared service-page template, with the sector grid in the
// "after-hero" slot.
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServicePageBody from '../../components/ServicePageBody.astro';
import { Image } from 'astro:assets';
import { sectorPhotos, heroes } from '../../data/photos';

const order = ['hospitals', 'hotels', 'schools-colleges', 'office-buildings', 'industrial', 'facility-maintenance'];
const sectors = (await getCollection('commercial')).sort((a, b) => order.indexOf(a.slug) - order.indexOf(b.slug));

const data = {
  title: 'Commercial Heating Services',
  h1: 'Commercial power flushing and heating services across Ireland',
  heroSubheading:
    'Restore full heating performance, cut energy bills and avoid expensive breakdowns in hospitals, hotels, schools, offices and industrial sites nationwide.',
  intro:
    "When sludge builds up in a commercial heating system the signs show quickly: radiators slow to heat, cold spots, noisy boilers, a building that won't warm up and energy bills that keep climbing. TMG Plumbing & Heating Services are plumbers and heating contractors with over 20 years' commercial experience. We use professional flushing, filtration and demineralising equipment to clear the build-up and protect the system, with minimal disruption to the people using the building.",
  about: {
    heading: 'The buildings we keep warm',
    paragraphs: [
      'Whatever kind of building you run, nobody should have to work, learn, recover or stay in a cold room. We work across a wide range of commercial and public buildings, including schools and colleges, hotels and B&Bs, hospitals, offices, restaurants, cafés and bars, gyms and leisure centres, warehouses and industrial units, retail units, apartment complexes and public buildings.',
      'We work quickly, keep the site tidy and plan around your occupants. Most of the cleaning is done while the system runs, so in most cases people won\'t even notice we are there.',
    ],
  },
  signsHeading: 'Signs your commercial heating system needs a clean-out',
  signs: [
    'Some rooms roasting while others stay cold',
    'Radiators cold at the bottom but warm at the top',
    'Banging, rumbling or gurgling from the boiler',
    'The building takes a long time to warm up in the morning',
    'Energy bills rising, especially in winter',
    'A boiler or pump that keeps needing repairs',
  ],
  stepsHeading: 'How we power flush commercial heating systems',
  steps: [
    { title: 'System check-up', body: 'We look over boilers, pumps, pipework, radiators, fan coils and underfloor loops to see where sludge is gathering and what needs the most attention.' },
    { title: 'Water analysis', body: 'A sample of the system water shows pH, corrosion indicators and how badly the system has been affected over time.' },
    { title: 'System filtration', body: 'We remove built-up sludge and debris from pipes, radiators and underfloor heating. Most of the time there is no need to drain the system or use harsh chemicals.' },
    { title: 'Power flushing', body: 'Clean water is circulated at high speed but low pressure to lift out years of sludge, rust and grime without straining the pipework.' },
    { title: 'Magnetic filtration', body: 'As the sludge comes loose, magnetic filters capture the fine metal particles that would otherwise settle back and cause corrosion.' },
    { title: 'Demineralisation', body: 'The water is topped up and run through a demineraliser to remove remaining contaminants, so it stays balanced and non-corrosive.' },
    { title: 'Final check', body: 'With everything running clear, we check heat distribution, flow rates, boiler performance and radiator recovery times.' },
  ],
  video: { youtubeId: 'hLRkwE2Rdec', title: 'Our process: power flushing and demineralising a heating system', caption: 'See how we clean and treat a commercial heating system, step by step.' },
  benefitsHeading: 'The benefits of commercial power flushing',
  benefits: [
    'Stronger heating performance, with warmth reaching every room',
    'Less wear on boilers, pumps and valves once blockages are gone',
    'Lower heating bills, especially when the system is working flat out',
    'Minimal disruption: we work quickly, tidily and around your schedule',
    'Treated water that meets manufacturer standards (VDI 2035)',
    'One contractor for flushing, water treatment and ongoing maintenance',
  ],
  sections: [
    {
      heading: 'Water treatment for commercial buildings',
      paragraphs: [
        'Flushing removes the build-up; treating the water stops it coming back. We demineralise commercial heating systems, install refill stations and Heating Water Regulators, and test the water every six months so it stays within manufacturer limits.',
      ],
      points: [],
    },
  ],
  faqs: [
    { q: 'Do you carry out commercial power flushing nationwide?', a: 'Yes. Our domestic work is focused on the South East, but we carry out commercial power flushing, demineralisation and water treatment anywhere in Ireland.' },
    { q: 'How much does commercial power flushing cost?', a: 'Commercial systems vary widely, so we price each one after a site survey, based on the plant, the number of circuits and radiators, and access. The quote is free and there is no obligation.' },
    { q: 'Can you work while the building is open?', a: 'Yes. Most of the cleaning is done through a bypass into our filtration unit while the system runs, and we plan the work around your occupants and timetable.' },
    { q: 'Do you flush underfloor heating and fan coil units?', a: 'Yes. We flush radiator systems, underfloor heating circuits, pipelines and fan coil units.' },
  ],
  downloads: [
    { label: 'Commercial power flushing brochure', href: '/s/Power-Flushing-Commercial_Digi.pdf', meta: 'PDF' },
    { label: 'Demineralising heating systems', href: '/s/TMG-Demineralising_EM.pdf', meta: 'PDF' },
  ],
  reading: [
    { title: 'Why commercial buildings need regular power flushing', href: '/blog/why-commercial-buildings-need-regular-power-flushing' },
    { title: 'The importance of industrial power flushing', href: '/blog/the-importance-of-industrial-power-flushing' },
    { title: 'Power flushing: frequently asked questions', href: '/blog/powerflushingfaq' },
  ],
  diagrams: ['flush', 'flushProcess'],
  relatedServices: ['demineralisation', 'leak-detection', 'plumbing-heating'],
};
---
<BaseLayout
  title="Commercial Power Flushing & Heating Contractors Ireland | TMG"
  description="Commercial power flushing, demineralisation and heating maintenance for hospitals, hotels, schools, offices and industrial sites across Ireland."
>
  <ServicePageBody
    data={data}
    photo={heroes.commercial}
    enquiry="Power Flushing - Commercial"
    badges={['Nationwide', '20+ years experience', 'Minimal disruption']}
    coverage="Commercial work across Ireland. Domestic work in Waterford, Wexford, Kilkenny, Tipperary and Kildare."
  >
    <section slot="after-hero" class="mx-auto max-w-6xl px-4 pt-12">
      <h2 class="text-2xl font-medium text-navy mb-6">Sectors we work in</h2>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
        {sectors.map((s) => (
          <a href={`/commercial/${s.slug}`} class="group relative rounded-card overflow-hidden aspect-[4/3] bg-navy">
            {sectorPhotos[s.slug] && (
              <Image src={sectorPhotos[s.slug].src} alt="" widths={[400, 700]} sizes="(min-width: 768px) 360px, 50vw" class="absolute inset-0 w-full h-full object-cover opacity-75 transition duration-300 group-hover:opacity-90 group-hover:scale-105" />
            )}
            <div class="absolute inset-0 bg-gradient-to-t from-navy/90 via-navy/30 to-transparent"></div>
            <p class="absolute left-4 bottom-4 right-4 text-white font-medium">{s.data.title.replace('Power Flushing for ', '').replace(/^\w/, (c) => c.toUpperCase())} →</p>
          </a>
        ))}
      </div>
    </section>
  </ServicePageBody>
</BaseLayout>
