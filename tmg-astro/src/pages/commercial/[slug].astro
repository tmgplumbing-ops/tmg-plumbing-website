---
// Commercial sector pages (hotels, hospitals, schools, offices, industrial,
// facility maintenance). Since the Oct 2026 content rewrite they share the
// service-page template, with the sector photo and a commercial enquiry type.
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServicePageBody from '../../components/ServicePageBody.astro';
import { sectorPhotos } from '../../data/photos';

export async function getStaticPaths() {
  const sectors = await getCollection('commercial');
  return sectors.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}
const { entry } = Astro.props;
const { title, metaDescription, seoTitle } = entry.data;
const enquiry = entry.slug === 'facility-maintenance' ? 'Commercial Facility Maintenance' : 'Power Flushing - Commercial';
---
<BaseLayout title={seoTitle ?? `${title} | TMG Plumbing & Heating`} description={metaDescription}>
  <ServicePageBody
    data={entry.data}
    photo={sectorPhotos[entry.slug]}
    enquiry={enquiry}
    badges={['Nationwide', '20+ years experience', 'Minimal disruption']}
    coverage="Commercial work across Ireland. Domestic work in Waterford, Wexford, Kilkenny, Tipperary and Kildare."
  />
</BaseLayout>
