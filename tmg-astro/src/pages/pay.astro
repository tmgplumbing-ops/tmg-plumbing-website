---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Pay Online | TMG Plumbing & Heating"
  description="Pay your TMG Plumbing & Heating invoice securely online."
>
  <section class="mx-auto max-w-2xl px-4 py-20 text-center">
    <h1 class="text-3xl font-medium text-navy mb-4">Pay Online</h1>
    <p class="text-navy/60 mb-8">
      Pay your invoice securely online. You'll need your invoice number to hand.
    </p>
    <!--
      Existing Stripe payment portal, per the brief (section 4, "Pay online
      — Existing Stripe portal"). Replace the href below with the live
      Stripe Checkout / Payment Link, or embed the Stripe payment element
      directly if a fully in-page experience is preferred.
    -->
    <a href="#" class="inline-block rounded bg-orange text-white font-medium px-8 py-4 hover:bg-orange-dark">
      Continue to secure payment
    </a>
    <p class="mt-6 text-xs text-navy/40">Payments are processed securely via Stripe.</p>
  </section>
</BaseLayout>
