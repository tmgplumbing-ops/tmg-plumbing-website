---
// Five main headings (Tony, 26 Sep 2026; 'Heating water treatment' renamed 4 Oct): Domestic, Commercial, Heating water treatment,
// Drinking water, Heating products. Page addresses are unchanged, so no new
// redirects are needed. About and Blog live in the footer and the mobile menu.
type Link = { name: string; href: string };
type Heading = { name: string; href?: string; items?: Link[]; local?: Link[] };

const headings: Heading[] = [
  {
    name: 'Domestic',
    items: [
      { name: 'Power flushing', href: '/services/power-flushing' },
      { name: 'Underfloor heating', href: '/services/underfloor-heating' },
      { name: 'Leak detection', href: '/services/leak-detection' },
      { name: 'Oil boiler installs', href: '/services/oil-boiler-installs' },
      { name: 'Plumbing & heating', href: '/services/plumbing-heating' },
    ],
    // Local area pages: shown small and muted under the main links.
    local: [
      { name: 'Waterford', href: '/power-flushing-waterford' },
      { name: 'Kilkenny', href: '/power-flushing-kilkenny' },
      { name: 'Wexford', href: '/power-flushing-wexford' },
      { name: 'Tipperary', href: '/power-flushing-tipperary' },
    ],
  },
  {
    name: 'Commercial',
    items: [
      { name: 'Overview', href: '/commercial' },
      { name: 'Hotels', href: '/commercial/hotels' },
      { name: 'Hospitals', href: '/commercial/hospitals' },
      { name: 'Schools & colleges', href: '/commercial/schools-colleges' },
      { name: 'Offices', href: '/commercial/office-buildings' },
      { name: 'Industrial', href: '/commercial/industrial' },
      { name: 'Pharmaceutical', href: '/commercial/pharmaceutical' },
      { name: 'Data centres', href: '/commercial/data-centres' },
      { name: 'Facility maintenance', href: '/commercial/facility-maintenance' },
    ],
  },
  {
    name: 'Heating water treatment',
    items: [
      { name: 'Overview', href: '/water-treatment' },
      { name: 'Demineralisation (homes)', href: '/services/demineralisation' },
      { name: 'Commercial demineralisation', href: '/water-treatment#commercial-demineralisation' },
      { name: 'Water testing', href: '/water-treatment#water-testing' },
      { name: 'Chemical-free pipe cleaning', href: '/water-treatment#chemical-free-pipe-cleaning' },
    ],
  },
  { name: 'Drinking water', href: '/services/drinking-water' },
  { name: 'Heating products', href: '/heating-products' },
];
const extra: Link[] = [
  { name: 'About', href: '/about' },
  { name: 'Blog', href: '/blog' },
];
import { whatsappHref } from '../data/whatsapp';
---
<!-- Dropdowns are plain <details> so they work with zero JS (mobile-first, fast). -->
<header class="sticky top-0 z-50 bg-white/95 backdrop-blur border-b border-navy/10">
  <div class="mx-auto max-w-6xl flex items-center justify-between gap-4 px-4 h-16">
    <a href="/" class="flex items-center gap-2 shrink-0">
      <img src="/images/logo-mark.png" alt="TMG Plumbing & Heating Services" class="w-10 h-10" width="40" height="40" />
      <span class="hidden sm:block font-medium text-navy leading-tight text-sm">
        PLUMBING<br />&amp; HEATING
      </span>
    </a>

    <nav class="hidden lg:flex items-center gap-5 text-sm text-navy/80">
      {headings.map((h) =>
        h.items ? (
          <details class="nav-dd relative">
            <summary class="list-none cursor-pointer hover:text-navy whitespace-nowrap">{h.name} <span aria-hidden="true" class="text-xs">▾</span></summary>
            <div class="absolute left-0 mt-2 w-64 rounded-card bg-white border border-navy/10 p-2 shadow-xl">
              {h.items.map((s) => (
                <a href={s.href} class="block px-3 py-2 rounded hover:bg-mist hover:text-orange">{s.name}</a>
              ))}
              {h.local && (
                <div class="mt-1 border-t border-navy/10 px-3 pt-2 pb-1 text-xs text-navy/45">
                  <span>Power flushing in </span>
                  {h.local.map((l, i) => (
                    <span><a href={l.href} class="hover:text-orange">{l.name}</a>{i < h.local!.length - 1 ? ' · ' : ''}</span>
                  ))}
                </div>
              )}
            </div>
          </details>
        ) : (
          <a href={h.href} class="hover:text-navy whitespace-nowrap">{h.name}</a>
        )
      )}
    </nav>

    <div class="flex items-center gap-3">
      <a href="tel:051577089" class="hidden xl:inline text-navy/80 hover:text-navy text-sm whitespace-nowrap">051 577 089</a>
      <a href={whatsappHref} target="_blank" rel="noopener" aria-label="Message us on WhatsApp" title="Message us on WhatsApp" class="inline-flex items-center gap-1.5 rounded border border-[#1FAF38] text-[#128C3E] text-sm font-medium px-2.5 sm:px-3 py-2 hover:bg-[#1FAF38] hover:text-white transition-colors whitespace-nowrap">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.66.15-.2.3-.76.96-.93 1.16-.17.2-.34.22-.64.07-.3-.15-1.25-.46-2.38-1.47-.88-.79-1.47-1.76-1.65-2.06-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.66-1.6-.91-2.19-.24-.58-.48-.5-.66-.5h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.01-1.04 2.47s1.06 2.87 1.21 3.07c.15.2 2.09 3.19 5.06 4.47.71.31 1.26.49 1.69.62.71.23 1.36.2 1.87.12.57-.08 1.75-.72 2-1.41.25-.69.25-1.29.17-1.41-.07-.12-.27-.2-.57-.35zM12.05 21.5h-.01a9.43 9.43 0 0 1-4.8-1.32l-.35-.2-3.57.93.95-3.48-.22-.36a9.4 9.4 0 0 1-1.44-5.02c0-5.2 4.24-9.44 9.45-9.44a9.38 9.38 0 0 1 6.68 2.77 9.38 9.38 0 0 1 2.76 6.68c0 5.21-4.24 9.44-9.45 9.44zm8.04-17.48A11.3 11.3 0 0 0 12.05.7C5.78.7.67 5.8.67 12.08c0 2 .52 3.96 1.52 5.69L.57 23.3l5.67-1.49a11.34 11.34 0 0 0 5.8 1.48h.01c6.27 0 11.38-5.11 11.38-11.39 0-3.04-1.18-5.9-3.34-8.05z"/></svg>
        <span class="hidden sm:inline lg:hidden">WhatsApp</span>
      </a>
      <a href="/contact" class="rounded bg-orange text-white text-sm font-medium px-4 py-2 hover:bg-orange-dark transition-colors whitespace-nowrap">
        Get a quote
      </a>
      <details class="lg:hidden">
        <summary class="list-none cursor-pointer p-2 -mr-2 text-navy" aria-label="Menu">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
        </summary>
        <div class="absolute left-0 right-0 top-16 bg-white border-b border-navy/10 shadow-xl max-h-[calc(100vh-4rem)] overflow-y-auto">
          <div class="mx-auto max-w-6xl px-4 py-3 text-navy">
            {headings.map((h) =>
              h.items ? (
                <details class="border-b border-navy/10">
                  <summary class="list-none cursor-pointer py-3 font-medium flex justify-between">{h.name} <span aria-hidden="true">▾</span></summary>
                  <div class="pb-2 pl-3">
                    {h.items.map((s) => (
                      <a href={s.href} class="block py-2 text-navy/80 hover:text-orange">{s.name}</a>
                    ))}
                    {h.local && (
                      <p class="py-2 text-xs text-navy/45">
                        Power flushing in {h.local.map((l, i) => <span><a href={l.href} class="underline hover:text-orange">{l.name}</a>{i < h.local!.length - 1 ? ', ' : ''}</span>)}
                      </p>
                    )}
                  </div>
                </details>
              ) : (
                <a href={h.href} class="block py-3 font-medium border-b border-navy/10 hover:text-orange">{h.name}</a>
              )
            )}
            {extra.map((s) => (
              <a href={s.href} class="block py-3 border-b border-navy/10 text-navy/80 hover:text-orange">{s.name}</a>
            ))}
            <a href="tel:051577089" class="block py-3 border-b border-navy/10 text-navy/80 hover:text-orange">Call 051 577 089</a>
            <a href={whatsappHref} target="_blank" rel="noopener" class="block py-3 text-navy/80 hover:text-orange">Message us on WhatsApp</a>
          </div>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  // Close any open desktop dropdown when clicking elsewhere or opening another.
  const dds = document.querySelectorAll<HTMLDetailsElement>('details.nav-dd');
  document.addEventListener('click', (e) => {
    dds.forEach((d) => { if (!d.contains(e.target as Node)) d.open = false; });
  });
</script>
