---
// Drinking water: hard mains water is treated at the point of entry, so taps and appliances get scale-free water.
---
<svg viewBox="0 0 900 290" class="w-full h-auto" role="img" aria-labelledby="dw-title dw-desc" font-family="inherit">
  <title id="dw-title">How whole-house water treatment works</title>
  <desc id="dw-desc">Hard mains water enters the house and passes through a scale transformer or softener fitted near the water meter. Treated water then reaches the kitchen tap, shower, kettle and appliances without leaving limescale behind.</desc>
  <defs>
    <marker id="dw-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0 L10 5 L0 10 z" fill="#CE5600" /></marker>
  </defs>

  <!-- Mains -->
  <rect x="20" y="110" width="150" height="70" rx="12" fill="#E4ECF6" stroke="#002050" stroke-opacity="0.25" />
  <path d="M36 150 h118" stroke="#9AA7BA" stroke-width="14" stroke-linecap="round" />
  {[50, 80, 110, 138].map((x, i) => <circle cx={x} cy={150 + (i % 2 ? -3 : 3)} r="4" fill="#FFFFFF" stroke="#002050" stroke-width="1.5" />)}
  <text x="95" y="215" text-anchor="middle" font-size="20" font-weight="500" fill="#002050">Hard mains water</text>
  <text x="95" y="238" text-anchor="middle" font-size="15" fill="#002050" fill-opacity="0.65">calcium &amp; magnesium</text>

  <line x1="176" y1="145" x2="262" y2="145" stroke="#CE5600" stroke-width="4" marker-end="url(#dw-arrow)" />

  <!-- Treatment unit -->
  <rect x="272" y="80" width="170" height="130" rx="16" fill="#FFFFFF" stroke="#002050" stroke-width="2.5" />
  <rect x="300" y="100" width="114" height="48" rx="8" fill="#002050" />
  <path d="M312 124 h90" stroke="#CE5600" stroke-width="3" stroke-dasharray="4 5" />
  <rect x="330" y="160" width="54" height="34" rx="6" fill="#E4ECF6" stroke="#002050" stroke-opacity="0.3" />
  <text x="357" y="238" text-anchor="middle" font-size="20" font-weight="500" fill="#002050">Scale transformer</text>
  <text x="357" y="261" text-anchor="middle" font-size="15" fill="#002050" fill-opacity="0.65">or softener, fitted at the meter</text>

  <line x1="448" y1="145" x2="534" y2="145" stroke="#CE5600" stroke-width="4" marker-end="url(#dw-arrow)" />

  <!-- Outlets -->
  <g transform="translate(548 60)">
    <rect x="0" y="0" width="330" height="170" rx="16" fill="#E4ECF6" stroke="#002050" stroke-opacity="0.25" />
    <!-- tap -->
    <path d="M40 60 v-18 a14 14 0 0 1 14 -14 h26 v12 h-22 v20 z" fill="#002050" />
    <path d="M52 70 q-6 12 0 20 q6 -8 0 -20 z" fill="#7FA7D9" />
    <text x="56" y="130" text-anchor="middle" font-size="15" fill="#002050">Taps</text>
    <!-- shower -->
    <circle cx="150" cy="44" r="18" fill="#002050" />
    {[-10, 0, 10].map((d) => <line x1={150 + d} y1="66" x2={150 + d * 1.6} y2="98" stroke="#7FA7D9" stroke-width="3" stroke-linecap="round" />)}
    <text x="150" y="130" text-anchor="middle" font-size="15" fill="#002050">Shower</text>
    <!-- kettle -->
    <path d="M226 96 v-40 a10 10 0 0 1 10 -10 h30 a10 10 0 0 1 10 10 v40 z" fill="#002050" />
    <path d="M276 60 h10 a8 8 0 0 1 0 16 h-10" fill="none" stroke="#002050" stroke-width="5" />
    <text x="256" y="130" text-anchor="middle" font-size="15" fill="#002050">Appliances</text>
    <text x="165" y="158" text-anchor="middle" font-size="15" fill="#CE5600">no limescale build-up</text>
  </g>
</svg>
