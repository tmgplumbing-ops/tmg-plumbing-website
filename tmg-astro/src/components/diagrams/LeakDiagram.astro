---
// Leak detection: three non-invasive ways of finding a hidden leak.
---
<svg viewBox="0 0 900 300" class="w-full h-auto" role="img" aria-labelledby="leak-title leak-desc" font-family="inherit">
  <title id="leak-title">How we find hidden leaks</title>
  <desc id="leak-desc">Three non-invasive methods: thermal imaging shows warm water escaping under a floor, acoustic listening picks up the sound of the leak, and pressure testing confirms which section of pipework is losing water.</desc>

  <!-- Ground + pipe with leak, shared -->
  {[0, 1, 2].map((i) => (
    <g transform={`translate(${30 + i * 290} 0)`}>
      <rect x="0" y="150" width="260" height="70" rx="8" fill="#E4ECF6" />
      <line x1="0" y1="150" x2="260" y2="150" stroke="#002050" stroke-width="3" />
      <rect x="10" y="186" width="240" height="14" rx="7" fill="#9AA7BA" />
      <path d="M130 186 q-6 -10 0 -18 q6 8 0 18 z" fill="#7FA7D9" />
    </g>
  ))}

  <!-- 1 Thermal -->
  <g transform="translate(30 0)">
    <ellipse cx="130" cy="150" rx="70" ry="16" fill="#CE5600" fill-opacity="0.35" />
    <ellipse cx="130" cy="150" rx="36" ry="9" fill="#CE5600" fill-opacity="0.6" />
    <rect x="96" y="40" width="68" height="52" rx="8" fill="#002050" />
    <rect x="104" y="48" width="52" height="30" rx="3" fill="#CE5600" />
    <rect x="120" y="92" width="20" height="30" rx="4" fill="#002050" />
    <text x="130" y="252" text-anchor="middle" font-size="20" font-weight="500" fill="#002050">Thermal imaging</text>
    <text x="130" y="275" text-anchor="middle" font-size="15" fill="#002050" fill-opacity="0.65">spots warm water escaping</text>
  </g>

  <!-- 2 Acoustic -->
  <g transform="translate(320 0)">
    <path d="M100 60 a30 30 0 0 1 60 0" fill="none" stroke="#002050" stroke-width="5" />
    <rect x="90" y="56" width="16" height="26" rx="6" fill="#002050" /><rect x="154" y="56" width="16" height="26" rx="6" fill="#002050" />
    <rect x="124" y="118" width="12" height="32" fill="#002050" /><ellipse cx="130" cy="146" rx="22" ry="6" fill="#002050" />
    {[0, 1, 2].map((k) => <path d={`M${100 - k * 14} ${178 - k * 4} q30 ${-20 - k * 6} 60 0`} fill="none" stroke="#CE5600" stroke-width="2.5" stroke-opacity={1 - k * 0.25} transform="translate(0 0)" />)}
    <text x="130" y="252" text-anchor="middle" font-size="20" font-weight="500" fill="#002050">Acoustic listening</text>
    <text x="130" y="275" text-anchor="middle" font-size="15" fill="#002050" fill-opacity="0.65">hears the leak through the floor</text>
  </g>

  <!-- 3 Pressure testing -->
  <g transform="translate(610 0)">
    <circle cx="130" cy="92" r="40" fill="#fff" stroke="#002050" stroke-width="4" />
    {[-60, -30, 0, 30, 60].map((a) => <line x1={130 + 30 * Math.sin(a * Math.PI / 180)} y1={92 - 30 * Math.cos(a * Math.PI / 180)} x2={130 + 36 * Math.sin(a * Math.PI / 180)} y2={92 - 36 * Math.cos(a * Math.PI / 180)} stroke="#002050" stroke-width="2.5" />)}
    <line x1="130" y1="92" x2="108" y2="74" stroke="#CE5600" stroke-width="4" stroke-linecap="round" />
    <circle cx="130" cy="92" r="5" fill="#002050" />
    <rect x="124" y="132" width="12" height="22" fill="#002050" />
    <text x="130" y="252" text-anchor="middle" font-size="20" font-weight="500" fill="#002050">Pressure testing</text>
    <text x="130" y="275" text-anchor="middle" font-size="15" fill="#002050" fill-opacity="0.65">confirms which pipe is losing water</text>
  </g>
</svg>
