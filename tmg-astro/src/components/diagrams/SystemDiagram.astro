---
// Heating system schematic used on the oil boiler and plumbing & heating pages.
// variant "oil" starts from a bunded oil tank; "heating" shows the boiler, pump and radiator loop.
interface Props { variant: 'oil' | 'heating' }
const { variant } = Astro.props;
const oil = variant === 'oil';
---
<svg viewBox="0 0 900 300" class="w-full h-auto" role="img" aria-labelledby={`sys-${variant}-title sys-${variant}-desc`} font-family="inherit">
  <title id={`sys-${variant}-title`}>{oil ? 'How an oil heating system fits together' : 'How a heating system works'}</title>
  <desc id={`sys-${variant}-desc`}>{oil
    ? 'Oil is fed from a bunded tank to the boiler. The boiler heats water, which is pumped to the hot water cylinder and around the radiators, then returns to be reheated.'
    : 'The boiler heats water, the pump sends it out along the flow pipe to the radiators and hot water cylinder, and cooler water comes back along the return pipe to be reheated.'}</desc>
  <defs>
    <marker id={`sys-${variant}-a`} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0 0 L10 5 L0 10 z" fill="#CE5600" /></marker>
    <marker id={`sys-${variant}-b`} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0 0 L10 5 L0 10 z" fill="#5E86C2" /></marker>
  </defs>

  {oil && (
    <g>
      <rect x="20" y="120" width="130" height="90" rx="16" fill="#3F6B4E" />
      <rect x="32" y="132" width="106" height="66" rx="10" fill="none" stroke="#FFFFFF" stroke-opacity="0.5" stroke-width="2" />
      <text x="85" y="245" text-anchor="middle" font-size="18" font-weight="500" fill="#002050">Bunded oil tank</text>
      <line x1="150" y1="165" x2="222" y2="165" stroke="#002050" stroke-width="3" stroke-dasharray="7 5" />
      <text x="186" y="155" text-anchor="middle" font-size="13" fill="#002050" fill-opacity="0.6">oil feed</text>
    </g>
  )}

  <!-- Boiler -->
  <g transform={`translate(${oil ? 230 : 60} 70)`}>
    <rect x="0" y="0" width="120" height="160" rx="10" fill="#FFFFFF" stroke="#002050" stroke-width="2.5" />
    <rect x="18" y="18" width="84" height="26" rx="4" fill="#E4ECF6" />
    <path d="M60 138 c-14 -8 -14 -24 0 -38 c3 12 14 14 10 28 c7 -2 9 -7 9 -12 c5 14 -5 22 -19 22 z" fill="#CE5600" />
    <text x="60" y="190" text-anchor="middle" font-size="18" font-weight="500" fill="#002050">Boiler</text>
  </g>

  <!-- Flow (hot) and return (cool) -->
  {(() => {
    const bx = oil ? 350 : 180;
    return (
      <g>
        <path d={`M${bx} 100 H${oil ? 420 : 300}`} stroke="#CE5600" stroke-width="5" fill="none" />
        <circle cx={oil ? 440 : 320} cy="100" r="18" fill="#FFFFFF" stroke="#002050" stroke-width="2.5" />
        <path d={`M${(oil ? 440 : 320) - 7} ${92} l14 8 -14 8 z`} fill="#002050" />
        <text x={oil ? 440 : 320} y="70" text-anchor="middle" font-size="14" fill="#002050" fill-opacity="0.65">pump</text>
        <path d={`M${oil ? 458 : 338} 100 H860`} stroke="#CE5600" stroke-width="5" fill="none" marker-end={`url(#sys-${variant}-a)`} />
        <path d={`M860 210 H${bx}`} stroke="#5E86C2" stroke-width="5" fill="none" marker-end={`url(#sys-${variant}-b)`} />
        <text x={oil ? 600 : 480} y="84" font-size="14" fill="#CE5600">flow (hot) →</text>
        <text x={bx + 12} y="262" font-size="14" fill="#5E86C2">← return (cooler)</text>
      </g>
    );
  })()}

  <!-- Cylinder -->
  <g transform={`translate(${oil ? 520 : 420} 110)`}>
    <line x1="30" y1="-10" x2="30" y2="0" stroke="#CE5600" stroke-width="4" />
    <rect x="0" y="0" width="60" height="96" rx="28" fill="#E4ECF6" stroke="#002050" stroke-width="2.5" />
    <line x1="30" y1="96" x2="30" y2="100" stroke="#5E86C2" stroke-width="4" />
    <text x="30" y="128" text-anchor="middle" font-size="16" font-weight="500" fill="#002050">Hot water</text>
  </g>

  <!-- Radiators -->
  {(oil ? [640, 760] : [560, 700]).map((x) => (
    <g transform={`translate(${x} 128)`}>
      <line x1="10" y1="-28" x2="10" y2="0" stroke="#CE5600" stroke-width="4" />
      <rect x="0" y="0" width="90" height="56" rx="6" fill="#F7B98A" stroke="#002050" stroke-width="2.5" />
      {[0, 1, 2, 3].map((k) => <line x1={18 + k * 18} y1="8" x2={18 + k * 18} y2="48" stroke="#002050" stroke-opacity="0.25" stroke-width="2" />)}
      <line x1="80" y1="56" x2="80" y2="82" stroke="#5E86C2" stroke-width="4" />
      <text x="45" y="110" text-anchor="middle" font-size="16" font-weight="500" fill="#002050">Radiator</text>
    </g>
  ))}
</svg>
