---
// Google reviews for the home page. Data comes from
// scripts/sync-google-reviews.mjs at build time. Nothing renders until the
// first successful fetch, so the page never shows an empty box.
import data from '../data/google-reviews.json';

const { rating, count, mapsUri, writeReviewUri } = data as any;
const reviews = ((data as any).reviews ?? []).slice(0, 3) as any[];
const show = rating && reviews.length > 0;
const stars = (n: number) => Array.from({ length: 5 }, (_, i) => i < Math.round(n));
const initials = (name: string) => name.split(/\s+/).map((w) => w[0]).slice(0, 2).join('').toUpperCase();
---
{show && (
  <section class="mx-auto max-w-6xl px-4 py-16" aria-labelledby="reviews-heading">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-8">
      <div>
        <p class="text-orange text-sm font-medium">Google reviews</p>
        <h2 id="reviews-heading" class="mt-2 text-2xl md:text-3xl font-medium text-navy">What our customers say</h2>
      </div>
      <div class="flex items-center gap-4 rounded-card bg-mist border border-navy/10 px-5 py-4">
        <p class="text-4xl font-medium text-navy leading-none">{Number(rating).toFixed(1)}</p>
        <div>
          <div class="flex gap-0.5" aria-label={`Rated ${Number(rating).toFixed(1)} out of 5`}>
            {stars(rating).map((on) => (
              <svg viewBox="0 0 20 20" class="w-5 h-5" aria-hidden="true"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1 5.9L10 14.9l-5.2 2.8 1-5.9L1.5 7.7l5.9-.8z" fill={on ? '#F5A623' : '#D7DCE4'} /></svg>
            ))}
          </div>
          <p class="mt-1 text-sm text-navy/60">Based on {count} reviews on Google</p>
        </div>
      </div>
    </div>

    <div class="grid md:grid-cols-3 gap-4">
      {reviews.map((r) => (
        <figure class={`rounded-card border border-navy/10 bg-white p-6 flex flex-col `}>
          <div class="flex gap-0.5" aria-label={`${r.rating} out of 5 stars`}>
            {stars(r.rating).map((on) => (
              <svg viewBox="0 0 20 20" class="w-4 h-4" aria-hidden="true"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1 5.9L10 14.9l-5.2 2.8 1-5.9L1.5 7.7l5.9-.8z" fill={on ? '#F5A623' : '#D7DCE4'} /></svg>
            ))}
          </div>
          <blockquote class="review-text mt-3 text-navy/80 leading-relaxed line-clamp-6">{r.text}</blockquote>
          <button type="button" class="review-more hidden self-start mt-2 text-sm text-orange hover:underline">Read more</button>
          <figcaption class="mt-auto pt-5 flex items-center gap-3">
            {r.photoUri
              ? <img src={r.photoUri} alt="" width="36" height="36" loading="lazy" referrerpolicy="no-referrer" class="w-9 h-9 rounded-full" />
              : <span class="w-9 h-9 rounded-full bg-navy text-white text-xs font-medium flex items-center justify-center">{initials(r.author)}</span>}
            <span class="text-sm">
              {r.authorUri
                ? <a href={r.authorUri} target="_blank" rel="noopener nofollow" class="text-navy font-medium hover:text-orange">{r.author}</a>
                : <span class="text-navy font-medium">{r.author}</span>}
              <span class="block text-navy/50">{r.when}</span>
            </span>
          </figcaption>
        </figure>
      ))}
    </div>

    <div class="mt-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <p class="text-xs text-navy/50">Reviews from Google</p>
      <div class="flex flex-wrap gap-3">
        {mapsUri && <a href={mapsUri} target="_blank" rel="noopener" class="rounded border border-navy/20 text-navy px-5 py-2.5 text-sm hover:border-orange hover:text-orange">Read all reviews on Google</a>}
        {writeReviewUri && <a href={writeReviewUri} target="_blank" rel="noopener" class="rounded bg-orange text-white px-5 py-2.5 text-sm font-medium hover:bg-orange-dark">Leave us a review</a>}
      </div>
    </div>
  </section>
)}

<script>
  // Only show "Read more" on reviews that are actually cut short.
  document.querySelectorAll<HTMLElement>('.review-text').forEach((q) => {
    const btn = q.nextElementSibling as HTMLButtonElement | null;
    if (!btn || q.scrollHeight <= q.clientHeight + 2) return;
    btn.classList.remove('hidden');
    btn.addEventListener('click', () => { q.classList.remove('line-clamp-6'); btn.remove(); });
  });
</script>
