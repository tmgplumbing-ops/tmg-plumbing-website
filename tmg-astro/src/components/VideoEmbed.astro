---
// YouTube video that only loads when the visitor presses play: keeps pages
// fast and sets no YouTube cookies until then (privacy-enhanced domain).
// With no youtubeId it shows a "video coming soon" placeholder.
interface Props { youtubeId?: string; title: string; caption?: string }
const { youtubeId, title, caption } = Astro.props;
---
<figure class="rounded-card overflow-hidden border border-navy/10 bg-navy">
  {youtubeId ? (
    <button
      type="button"
      class="tmg-video group relative block w-full aspect-video"
      data-yt={youtubeId}
      data-title={title}
      aria-label={`Play video: ${title}`}
    >
      <img
        src={`https://i.ytimg.com/vi/${youtubeId}/hqdefault.jpg`}
        alt=""
        loading="lazy"
        class="absolute inset-0 w-full h-full object-cover opacity-80 group-hover:opacity-95 transition"
      />
      <span class="absolute inset-0 bg-gradient-to-t from-navy/80 to-transparent"></span>
      <span class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-16 h-16 rounded-full bg-orange flex items-center justify-center shadow-lg group-hover:scale-110 transition">
        <svg viewBox="0 0 24 24" class="w-7 h-7 ml-1" aria-hidden="true"><path d="M7 5v14l12-7z" fill="#fff" /></svg>
      </span>
      <span class="absolute left-4 bottom-3 right-4 text-left text-white text-sm font-medium">{title}</span>
    </button>
  ) : (
    <div class="aspect-video flex flex-col items-center justify-center text-center px-6">
      <span class="w-14 h-14 rounded-full border-2 border-orange/60 flex items-center justify-center">
        <svg viewBox="0 0 24 24" class="w-6 h-6 ml-0.5" aria-hidden="true"><path d="M7 5v14l12-7z" fill="#CE5600" /></svg>
      </span>
      <p class="mt-3 text-white font-medium">{title}</p>
      <p class="mt-1 text-white/60 text-sm">Video coming soon</p>
    </div>
  )}
  {caption && <figcaption class="bg-white px-4 py-3 text-sm text-navy/70">{caption}</figcaption>}
</figure>

<script is:inline>
  document.addEventListener('click', function (e) {
    var b = e.target.closest && e.target.closest('.tmg-video');
    if (!b) return;
    var f = document.createElement('iframe');
    f.src = 'https://www.youtube-nocookie.com/embed/' + b.getAttribute('data-yt') + '?autoplay=1&rel=0';
    f.title = b.getAttribute('data-title') || 'Video';
    f.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
    f.allowFullscreen = true;
    f.className = 'w-full aspect-video block';
    b.replaceWith(f);
  });
</script>
