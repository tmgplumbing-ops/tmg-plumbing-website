---
// Submits directly into the same Zoho CRM Leads pipeline as the existing
// tmgplumbing.ie site (Zoho "Web-to-Lead" form 825275000000611457, EU data
// centre). Field names below (e.g. "First Name", "LEADCF3") are dictated by
// Zoho and must match exactly — they are not free to rename.
const enquiryOptions = [
  'Power Flushing - Domestic',
  'Power Flushing - Commercial',
  'Underfloor Heating Servicing',
  'Leak Detection',
  'Demineralising Heating System',
  'Commercial Facility Maintenance',
  'Heating Installation',
  'Heating Products',
];
---
<form id="tmg-quote-form" class="space-y-4" novalidate>
  <!-- Zoho web-to-lead auth/tracking fields — required by their endpoint, do not remove -->
  <input type="hidden" name="xnQsjsdp" value="ddc25228582a49826d353ecaf9121bcb548f0b39a028f98ea4e556e5471a97fa" />
  <input type="hidden" name="zc_gad" value="" />
  <input type="hidden" name="xmIwtLD" value="700de371ac7da85e09ecff4f10e949daedab0a3e8267d198f872b650e357220dfdd0afd020100571ba06445324f934e9" />
  <input type="hidden" name="actionType" value="TGVhZHM=" />
  <input type="hidden" name="returnURL" value="/thanks-for-your-enquiry" />
  <input type="hidden" name="ldeskuid" value="" />
  <input type="hidden" name="LDTuvid" value="" />
  <input type="hidden" name="wFaTrisJS" value="true" />
  <input type="hidden" name="te" value="true" />
  <input type="hidden" name="wbfIanaFrD" value="7530f5d08c207e3d367b041217fead3189db49ee2d7e356979a6001eba587e065777dcff607bcea676d609883bce472d" />
  <input type="hidden" name="rw" value="9a66b35442d1e8498f832d3f61e8ac1c0b9dabdbc0306c9e8bd1e8bf1b4fcecd9d908255d42cf2adb6f811e0fab1c585" />
  <input type="hidden" name="la" value="e9d0a0c49bb959c89827c863739f1b1bc425fef33ecddc52de93c38812251e5f" />
  <input type="hidden" name="eo" value="537822bf1f126f3d47b01010351c5c09f7ae9d47b3561cda82580adc1f5b47f0" />
  <input type="hidden" name="webform_analytics_submission" value="" />
  <input type="hidden" name="_zwAvsckLs" value="" />
  <!-- honeypot — must stay empty; bots tend to fill every field -->
  <input type="text" name="aG9uZXlwb3Q" value="" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

  <div class="grid sm:grid-cols-2 gap-4">
    <input class="rounded bg-mist border border-navy/10 px-4 py-3" placeholder="First name" name="First Name" required />
    <input class="rounded bg-mist border border-navy/10 px-4 py-3" placeholder="Last name" name="Last Name" required />
  </div>
  <div class="grid sm:grid-cols-2 gap-4">
    <input class="rounded bg-mist border border-navy/10 px-4 py-3" placeholder="Phone" name="Phone" required />
    <input class="rounded bg-mist border border-navy/10 px-4 py-3" placeholder="Email" type="email" name="Email" required />
  </div>
  <div class="grid sm:grid-cols-2 gap-4">
    <input class="rounded bg-mist border border-navy/10 px-4 py-3" placeholder="Eircode" name="Zip Code" required />
    <input class="rounded bg-mist border border-navy/10 px-4 py-3" placeholder="Company (commercial enquiries)" name="Company" />
  </div>

  <select class="w-full rounded bg-mist border border-navy/10 px-4 py-3 text-navy/70" name="LEADCF3" required>
    <option value="-None-">What can we help with?</option>
    {enquiryOptions.map((o) => <option value={o}>{o}</option>)}
  </select>

  <textarea class="w-full rounded bg-mist border border-navy/10 px-4 py-3" placeholder="Describe the issue" name="Description" rows="4"></textarea>

  <div>
    <label class="block text-sm text-navy/60 mb-2">Photos (optional) — helps us scope the job before we call</label>
    <input type="file" name="theFile" multiple class="block w-full text-sm text-navy/70" />
  </div>

  <label class="flex items-start gap-2 text-xs text-navy/50">
    <input type="checkbox" name="Email Opt Out" class="mt-0.5" />
    I don't want to receive marketing emails from TMG
  </label>

  <button type="submit" class="rounded bg-orange text-white font-medium px-6 py-3 hover:bg-orange-dark disabled:opacity-60">
    Send request
  </button>
  <p id="tmg-quote-status" class="text-sm mt-2" role="status"></p>
  <p class="text-xs text-navy/40">We reply the same day, Mon–Fri.</p>
</form>

<script>
  const form = document.getElementById('tmg-quote-form') as HTMLFormElement | null;
  const statusEl = document.getElementById('tmg-quote-status');
  if (form && statusEl) {
    const returnInput = form.querySelector<HTMLInputElement>('input[name="returnURL"]');
    if (returnInput) returnInput.value = `${window.location.origin}/thanks-for-your-enquiry`;

    const requiredFields: [string, string][] = [
      ['First Name', 'First name'],
      ['Last Name', 'Last name'],
      ['Email', 'Email'],
      ['Phone', 'Phone'],
      ['Zip Code', 'Eircode'],
      ['LEADCF3', 'What can we help with'],
    ];

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      statusEl.textContent = '';

      // Silently drop likely-bot submissions (honeypot filled)
      const honeypot = form.querySelector<HTMLInputElement>('input[name="aG9uZXlwb3Q"]');
      if (honeypot && honeypot.value.trim() !== '') {
        statusEl.textContent = "Thanks — we'll be in touch shortly.";
        form.reset();
        return;
      }

      for (const [name, label] of requiredFields) {
        const field = form.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement | null;
        const value = field ? (field as HTMLInputElement).value.trim() : '';
        if (!value || value === '-None-') {
          statusEl.textContent = `${label} is required.`;
          field?.focus();
          return;
        }
      }
      const emailField = form.elements.namedItem('Email') as HTMLInputElement;
      if (emailField && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailField.value.trim())) {
        statusEl.textContent = 'Please enter a valid email address.';
        emailField.focus();
        return;
      }

      const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      submitBtn?.setAttribute('disabled', 'true');
      statusEl.textContent = 'Sending...';

      try {
        const formData = new FormData(form);
        const response = await fetch('https://crm.zoho.eu/crm/WebToLeadForm', {
          method: 'POST',
          body: formData,
          cache: 'no-cache',
        });
        if (!response.ok) throw new Error(`Zoho responded with ${response.status}`);
        window.location.assign(`${window.location.origin}/thanks-for-your-enquiry`);
      } catch (err) {
        statusEl.textContent = "Something went wrong sending that. Please call 051 577 089 or email info@tmgplumbing.ie instead.";
        submitBtn?.removeAttribute('disabled');
      }
    });
  }
</script>
