---
// Shared two-column template used by every /services/[slug] page AND every
// local SEO page — per "Service pages (template)" in section 5 of the brief.
// Main content left, sticky sidebar right; same structure, different intro.
import Schema from './Schema.astro';
import { getEntry } from 'astro:content';
import serviceNotices from '../data/service-notices.json';
import { Image } from 'astro:assets';
import QuoteForm from './QuoteForm.astro';
import ProductCards from './ProductCards.astro';
import { servicePhotos, photos } from '../data/photos';
import FlushDiagram from './diagrams/FlushDiagram.astro';
import UfhDiagram from './diagrams/UfhDiagram.astro';
import LeakDiagram from './diagrams/LeakDiagram.astro';
import DeminDiagram from './diagrams/DeminDiagram.astro';
import SystemDiagram from './diagrams/SystemDiagram.astro';
import DrinkingDiagram from './diagrams/DrinkingDiagram.astro';
import FlushProcessDiagram from './diagrams/FlushProcessDiagram.astro';
import UfhFlushDiagram from './diagrams/UfhFlushDiagram.astro';
import LeakSignsDiagram from './diagrams/LeakSignsDiagram.astro';
import HwrDiagram from './diagrams/HwrDiagram.astro';
import VideoEmbed from './VideoEmbed.astro';

interface Props {
  data: {
    title: string;
    heroSubheading: string;
    intro: string;
    signs: string[];
    steps: { title: string; body: string }[];
    benefits: string[];
    faqs: { q: string; a: string }[];
    relatedServices: string[];
    county?: string;
    [key: string]: any; // optional richer blocks: see src/content/config.ts
  };
  // Slug of the parent /services/ page (set on both the core service pages
  // and their local-SEO variants) — used to look up an optional staff
  // notice from Zoho's Website Pages module.
  noticeSlug?: string;
  // Overrides used by the commercial pages, which share this template.
  photo?: { src: any; alt: string; fit?: 'cover' | 'contain' };
  enquiry?: string;
  coverage?: string;
  badges?: string[];
}
const { data, noticeSlug, photo, enquiry, coverage, badges } = Astro.props;
const notice = noticeSlug ? serviceNotices[noticeSlug] : undefined;
const pics = photo ? { hero: photo } : noticeSlug ? servicePhotos[noticeSlug] : undefined;
// Diagrams: a page can list its own (`diagrams` in the content file); otherwise the service default.
const defaultDiagrams: Record<string, string[]> = {
  'power-flushing': ['flush', 'flushProcess'],
  'underfloor-heating': ['ufh', 'ufhFlush'],
  'leak-detection': ['leakSigns', 'leak'],
  demineralisation: ['demin'],
  'oil-boiler-installs': ['oil'],
  'plumbing-heating': ['heating'],
  'drinking-water': ['drinking'],
};
const diagrams: string[] = data.diagrams ?? (noticeSlug ? defaultDiagrams[noticeSlug] ?? [] : []);
const topDiagrams = diagrams.filter((d) => d !== 'flushProcess');
// Pre-fills the Zoho form's "Enquiring About" dropdown for this service.
const enquiryOption: Record<string, string> = {
  'power-flushing': 'Power Flushing - Domestic',
  'underfloor-heating': 'Underfloor Heating Servicing',
  'leak-detection': 'Leak Detection',
  demineralisation: 'Demineralising Heating System',
  'oil-boiler-installs': 'Heating Installation',
  'plumbing-heating': 'Heating Installation',
};
// Product cards per service page, carried over from the old site.
const serviceProducts: Record<string, { heading: string; intro: string; items: any[] }> = {
  'drinking-water': {
    heading: 'Hard water prevention products',
    intro: 'Limescale prevention and water softening solutions. They treat the water before it reaches your taps, appliances and devices, keeping it pleasant to drink and protecting your pipes from limescale damage.',
    items: [
      {
        id: 'scale-transformer',
        name: 'Magnetic Scale Transformer',
        tag: 'Fitted at the mains',
        img: photos.scaleTransformer.src,
        alt: 'Magnetic Scale Transformer fitted to a mains water meter',
        fit: 'cover',
        lead: 'A proven, low-maintenance way to stop limescale building up in your water system and damaging your plumbing.',
        points: ['Stops limescale coating taps and clogging pipes', 'Protects your hot water system', 'Longer-lasting appliances and lower maintenance costs'],
        pdf: '/s/ENG_magnetic_Kalkumwandler_web_ES.pdf',
        cta: 'Get in touch for more details',
      },
      {
        id: 'water-softener',
        name: 'Magnetic Water Softener',
        tag: 'Water softening',
        img: photos.softener.src,
        alt: 'Magnetic Water Softener with digital control panel and DIN DVGW certification seal',
        fit: 'contain',
        lead: 'Stubborn limescale slowly clogs pipes and wears out appliances before their time. The softener breaks down hard water build-up before it can do any real damage.',
        points: ['Breaks down hard water build-up', 'Smoother water flow', 'Fewer expensive repair bills'],
        pdf: '/s/ENG_magnetic_Enthaertungsanlage_11_web_ES.pdf',
        cta: 'Request more information',
      },
    ],
  },
};
const productsBlock = noticeSlug ? serviceProducts[noticeSlug] : undefined;
const related = await Promise.all(
  (data.relatedServices ?? []).map((slug) => getEntry('services', slug))
);
---
<Schema service={{ name: data.title, description: data.intro }} faqs={data.faqs} />

<!-- Hero -->
<section class="bg-navy border-b border-navy/10">
  <div class="mx-auto max-w-6xl px-4 py-16 grid md:grid-cols-[1fr_420px] gap-10 items-center">
    <div>
    <div class="flex flex-wrap gap-2 mb-4 text-xs text-orange">
      {(badges ?? ['20+ years experience', 'Fixed price before we start']).map((b) => <span class="rounded-full border border-orange/40 px-3 py-1">{b}</span>)}
      {data.county && <span class="rounded-full border border-orange/40 px-3 py-1">{data.county} & South East</span>}
    </div>
    <h1 class="text-3xl md:text-5xl font-medium text-white max-w-2xl">{data.h1 ?? data.title}</h1>
    <p class="mt-4 text-white/70 max-w-xl">{data.heroSubheading}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="#quote" class="rounded bg-orange text-white font-medium px-5 py-3 hover:bg-orange-dark">Get a quote</a>
      <a href="tel:051577089" class="rounded border border-white/20 text-white px-5 py-3 hover:border-orange hover:text-orange">Call 051 577 089</a>
    </div>
    </div>
    {pics && (
      <div class={`rounded-card overflow-hidden aspect-[4/3] ${pics.hero.fit === 'contain' ? 'bg-white p-6' : 'bg-white/5'}`}>
        <Image src={pics.hero.src} alt={pics.hero.alt} widths={[480, 840]} sizes="(min-width: 768px) 420px, 100vw" loading="eager" class={`w-full h-full ${pics.hero.fit === 'contain' ? 'object-contain' : 'object-cover'}`} />
      </div>
    )}
  </div>
</section>

{notice && (
  <section class="mx-auto max-w-6xl px-4 pt-8">
    <div class="rounded-card bg-orange/10 border border-orange/30 px-5 py-4 text-navy/80 text-sm" set:html={notice.body} />
  </section>
)}

<slot name="after-hero" />

<section class="mx-auto max-w-6xl px-4 py-12 grid md:grid-cols-[1fr_320px] gap-12">
  <!-- Main column -->
  <div class="space-y-12">
    <p class="text-navy/80 leading-relaxed text-lg">{data.intro}</p>

    {data.about && (
      <div>
        <h2 class="text-2xl font-medium text-navy mb-4">{data.about.heading}</h2>
        <div class="space-y-3 text-navy/75 leading-relaxed">
          {data.about.paragraphs.map((t: string) => <p>{t}</p>)}
        </div>
      </div>
    )}

    {topDiagrams.map((d) => (
      <figure class="rounded-card border border-navy/10 bg-white p-4 md:p-6">
        {d === 'flush' && <FlushDiagram />}
        {d === 'ufh' && <UfhDiagram />}
        {d === 'ufhFlush' && <UfhFlushDiagram />}
        {d === 'leak' && <LeakDiagram />}
        {d === 'leakSigns' && <LeakSignsDiagram />}
        {d === 'demin' && <DeminDiagram />}
        {d === 'hwr' && <HwrDiagram />}
        {d === 'oil' && <SystemDiagram variant="oil" />}
        {d === 'heating' && <SystemDiagram variant="heating" />}
        {d === 'drinking' && <DrinkingDiagram />}
      </figure>
    ))}

    <div>
      <h2 class="text-2xl font-medium text-navy mb-4">{data.signsHeading ?? 'Signs you need this'}</h2>
      <ul class="grid sm:grid-cols-2 gap-3">
        {data.signs.map((t: string) => (
          <li class="flex gap-3 rounded-card bg-mist border border-navy/10 p-4 text-navy/80 text-sm">
            <svg viewBox="0 0 20 20" class="w-5 h-5 flex-none text-orange" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="10" cy="10" r="8" /><path d="M10 6v5M10 14h.01" stroke-linecap="round" /></svg>
            {t}
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h2 class="text-2xl font-medium text-navy mb-4">{data.stepsHeading ?? 'How we do it'}</h2>
      <ol class="space-y-4">
        {data.steps.map((st: { title: string; body: string }, i: number) => (
          <li class="flex gap-4">
            <span class="flex-none w-9 h-9 rounded-full bg-orange text-white text-sm font-medium flex items-center justify-center">{i + 1}</span>
            <div>
              <p class="text-navy font-medium">{st.title}</p>
              <p class="text-navy/65 text-sm leading-relaxed mt-0.5">{st.body}</p>
            </div>
          </li>
        ))}
      </ol>
      {diagrams.includes('flushProcess') && (
        <figure class="mt-6 rounded-card border border-navy/10 bg-white p-4 md:p-6">
          <FlushProcessDiagram />
        </figure>
      )}
    </div>

    {data.video && <VideoEmbed youtubeId={data.video.youtubeId} title={data.video.title} caption={data.video.caption} />}

    {productsBlock && (
      <div id="products" class="scroll-mt-24">
        <h2 class="text-xl font-medium text-navy">{productsBlock.heading}</h2>
        <p class="mt-2 mb-6 text-navy/70 leading-relaxed">{productsBlock.intro}</p>
        <ProductCards products={productsBlock.items} ctaHref="#quote" />
        <div class="mt-6 rounded-card bg-navy text-white p-6 md:p-8 flex flex-col md:flex-row md:items-center gap-5 md:justify-between">
          <div>
            <p class="font-medium text-lg">Need help setting it up?</p>
            <p class="mt-1 text-white/70 text-sm leading-relaxed max-w-lg">We know these systems inside and out and will install yours for you, so your water flows clean and limescale stays away.</p>
          </div>
          <a href="#quote" class="shrink-0 rounded bg-orange text-white font-medium px-5 py-3 hover:bg-orange-dark">Book an installation</a>
        </div>
      </div>
    )}

    <div>
      <h2 class="text-2xl font-medium text-navy mb-4">{data.benefitsHeading ?? 'Benefits'}</h2>
      <div class="grid sm:grid-cols-2 gap-3">
        {data.benefits.map((b: string) => (
          <div class="flex gap-3 rounded-card bg-white border border-navy/10 p-4 text-navy/80 text-sm">
            <svg viewBox="0 0 20 20" class="w-5 h-5 flex-none" aria-hidden="true"><circle cx="10" cy="10" r="9" fill="#CE5600" fill-opacity="0.12" /><path d="M6 10.5l2.5 2.5L14 7.5" fill="none" stroke="#CE5600" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
            {b}
          </div>
        ))}
      </div>
    </div>

    {data.cost && (
      <div id="cost" class="scroll-mt-24 rounded-card bg-navy text-white p-6 md:p-8">
        <h2 class="text-2xl font-medium">{data.cost.heading}</h2>
        <p class="mt-3 text-white/75 leading-relaxed">{data.cost.intro}</p>
        <div class="mt-6 grid sm:grid-cols-2 gap-3">
          {data.cost.factors.map((f: { title: string; body: string }) => (
            <div class="rounded-card bg-white/5 border border-white/10 p-4">
              <p class="font-medium text-orange">{f.title}</p>
              <p class="mt-1 text-sm text-white/70 leading-relaxed">{f.body}</p>
            </div>
          ))}
        </div>
        {data.cost.note && <p class="mt-5 text-sm text-white/80">{data.cost.note}</p>}
        <a href="#quote" class="mt-6 inline-block rounded bg-orange text-white font-medium px-5 py-3 hover:bg-orange-dark">Get your fixed price</a>
      </div>
    )}

    {data.sections && data.sections.map((sec: { heading: string; paragraphs: string[]; points?: string[] }) => (
      <div>
        <h2 class="text-2xl font-medium text-navy mb-4">{sec.heading}</h2>
        <div class="space-y-3 text-navy/75 leading-relaxed">
          {sec.paragraphs.map((t) => <p>{t}</p>)}
        </div>
        {sec.points && (
          <ul class="mt-4 space-y-2 text-navy/80 text-sm">
            {sec.points.map((pt) => <li class="flex gap-2"><span class="text-orange">•</span>{pt}</li>)}
          </ul>
        )}
      </div>
    ))}

    {data.areas && (
      <div>
        <h2 class="text-2xl font-medium text-navy mb-2">{data.areas.heading}</h2>
        {data.areas.intro && <p class="text-navy/70 mb-4">{data.areas.intro}</p>}
        <ul class="flex flex-wrap gap-2">
          {data.areas.towns.map((t: string) => <li class="rounded-full bg-mist border border-navy/10 px-3 py-1 text-sm text-navy/75">{t}</li>)}
        </ul>
      </div>
    )}

    <div>
      <h2 class="text-2xl font-medium text-navy mb-4">Frequently asked questions</h2>
      <div class="space-y-3">
        {data.faqs.map((f: { q: string; a: string }) => (
          <details class="group rounded-card bg-mist border border-navy/10 p-4">
            <summary class="cursor-pointer list-none flex justify-between gap-4 text-navy font-medium">{f.q}<span class="text-orange transition-transform group-open:rotate-45" aria-hidden="true">+</span></summary>
            <p class="mt-2 text-navy/65 text-sm leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>
    </div>

    {data.downloads && (
      <div class="rounded-card bg-orange/10 border-2 border-orange/40 p-6 md:p-8">
        <div class="flex items-center gap-3">
          <span class="w-11 h-11 rounded-full bg-orange flex items-center justify-center flex-none">
            <svg viewBox="0 0 24 24" class="w-6 h-6" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11M7 10l5 5 5-5M5 20h14" /></svg>
          </span>
          <div>
            <h2 class="text-xl font-medium text-navy">Download our guides</h2>
            <p class="text-sm text-navy/65">Free PDFs to read now or keep for later.</p>
          </div>
        </div>
        <div class="mt-5 grid sm:grid-cols-2 gap-3">
          {data.downloads.map((d: { label: string; href: string; meta?: string }) => (
            <a href={d.href} target="_blank" rel="noopener" class="group flex items-center gap-4 rounded-card bg-white border border-navy/10 p-4 hover:border-orange hover:shadow-md transition">
              <span class="flex-none w-12 h-14 rounded-md bg-navy text-white text-xs font-medium flex items-end justify-center pb-2 relative">
                <span class="absolute top-0 right-0 w-4 h-4 bg-orange rounded-bl-md rounded-tr-md"></span>PDF
              </span>
              <span class="flex-1">
                <span class="block text-navy font-medium leading-snug group-hover:text-orange">{d.label}</span>
                {d.meta && <span class="block text-xs text-navy/50 mt-0.5">{d.meta}</span>}
              </span>
              <span class="text-orange text-sm font-medium">Download</span>
            </a>
          ))}
        </div>
      </div>
    )}

    {data.reading && (
      <div class="rounded-card border border-navy/10 bg-white p-5">
        <p class="text-navy font-medium mb-3">Further reading</p>
        <ul class="grid sm:grid-cols-2 gap-x-6 gap-y-2">
          {data.reading.map((r: { title: string; href: string }) => (
            <li><a href={r.href} class="text-sm text-navy hover:text-orange">{r.title} →</a></li>
          ))}
        </ul>
      </div>
    )}

    <div id="quote" class="scroll-mt-24 rounded-card border border-navy/10 bg-white p-6 md:p-8">
      <h2 class="text-xl font-medium text-navy">Request a free quote</h2>
      <p class="mt-1 mb-4 text-navy/60 text-sm">Fill in your details and we'll get back to you as soon as we can.</p>
      <QuoteForm preselect={enquiry ?? (noticeSlug ? enquiryOption[noticeSlug] : undefined)} />
    </div>
  </div>

  <!-- Sticky sidebar -->
  <aside class="md:sticky md:top-24 h-fit space-y-4">
    <div class="rounded-card bg-mist border border-navy/10 p-6">
      <p class="text-navy font-medium mb-3">Request a quote</p>
      <p class="text-navy/60 text-sm mb-4">Tell us what you need and we'll come back to you with a fixed price.</p>
      <a href="#quote" class="block text-center rounded bg-orange text-white font-medium px-4 py-2.5 hover:bg-orange-dark">Get a free quote</a>
      <a href="tel:051577089" class="mt-2 block text-center rounded border border-navy/20 text-navy px-4 py-2.5 hover:border-orange hover:text-orange">Call 051 577 089</a>
    </div>
    <div class="rounded-card bg-mist border border-navy/10 p-6 text-sm text-navy/70 space-y-2">
      <p><a href="tel:051577089" class="text-orange">051 577 089</a></p>
      <p>Mon–Fri, 8am–6pm · Emergency callouts 087 717 5624</p>
      <p class="pt-2 border-t border-navy/10">{coverage ?? 'Covering Waterford, Wexford, Kilkenny, Tipperary and Kildare, and commercial sites nationwide'}</p>
    </div>
  </aside>
</section>

{related.filter(Boolean).length > 0 && (
  <section class="mx-auto max-w-6xl px-4 pb-16">
    <h2 class="text-xl font-medium text-navy mb-4">You might also need</h2>
    <div class="grid sm:grid-cols-3 gap-4">
      {related.filter(Boolean).map((r) => (
        <a href={`/services/${r!.slug}`} class="rounded-card bg-mist border border-navy/10 p-5 hover:border-orange">
          <p class="text-navy font-medium">{r!.data.title}</p>
          <p class="text-navy/50 text-sm mt-1">Learn more →</p>
        </a>
      ))}
    </div>
  </section>
)}
