---
// Shared typography for the legal pages (terms, privacy, cookies).
---
<style is:global>
  .legal { color: rgba(0, 32, 80, 0.8); line-height: 1.75; }
  .legal h1 { font-size: 2rem; font-weight: 500; color: #002050; }
  .legal .updated { margin-top: 0.25rem; font-size: 0.875rem; color: rgba(0, 32, 80, 0.5); }
  .legal > * + * { margin-top: 1rem; }
  .legal h2 { font-size: 1.25rem; font-weight: 500; color: #002050; margin-top: 2.25rem; padding-top: 1.25rem; border-top: 1px solid rgba(0, 32, 80, 0.1); }
  .legal h3 { font-size: 1.05rem; font-weight: 500; color: #002050; margin-top: 1.5rem; }
  .legal .sub { padding-left: 1.5rem; margin-top: 0.4rem; }
  .legal a { color: #CE5600; text-decoration: underline; text-underline-offset: 2px; }
  .legal ul { list-style: disc; padding-left: 1.4rem; }
  .legal li + li { margin-top: 0.35rem; }
  .legal table { width: 100%; font-size: 0.9rem; border-collapse: collapse; }
  .legal th, .legal td { text-align: left; vertical-align: top; padding: 0.6rem 0.5rem; border-bottom: 1px solid rgba(0, 32, 80, 0.1); }
  .legal th { color: #002050; font-weight: 500; background: #F3F5F8; }
  .legal .download { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; background: #F3F5F8; border: 1px solid rgba(0, 32, 80, 0.1); border-radius: 12px; padding: 1.25rem 1.5rem; }
  .legal .download-title { color: #002050; font-weight: 500; }
  .legal .download-sub { font-size: 0.875rem; color: rgba(0, 32, 80, 0.6); margin-top: 0.15rem; }
  .legal .download a { background: #CE5600; color: #fff; text-decoration: none; border-radius: 8px; padding: 0.6rem 1.1rem; font-weight: 500; }
  .legal .download a:hover { background: #A84600; }
</style>
