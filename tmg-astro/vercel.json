{
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": ".*\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/s/250526-TMG-Full-Terms-and-Conditions.pdf",
      "destination": "/s/TMG-Terms-and-Conditions-of-Service.pdf",
      "permanent": true
    }
  ]
}
